# Database Configuration
# Для локальной разработки (Linux):
DATABASE_URL=postgresql+psycopg://postgres:postgres@0.0.0.0:5432/atomic_hack
# Для Docker: используйте имя сервиса вместо IP
# DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/atomic_hack

# S3 Storage Configuration
# Для локальной разработки с MinIO (Linux):
# S3_ENDPOINT_URL=http://0.0.0.0:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_USE_SSL=false
# S3_ADDRESSING_STYLE=path
# Для Docker: используйте имя сервиса
# S3_ENDPOINT_URL=http://minio:9000

# Для production с AWS S3 или совместимым:
TEMPLATE_BUCKET_NAME=atomic-hack-presentations
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_SESSION_TOKEN=
AWS_REGION=us-east-1
S3_ADDRESSING_STYLE=auto
S3_USE_SSL=true

# OpenAI-compatible API Configuration
# Для использования custom API просто измените base URL, синтаксис такой же как у OpenAI
QWEN_VL_API_BASE=https://bothub.chat/api/v2/openai/v1
QWEN_VL_API_KEY=your-qwen-vl-api-key-here
QWEN_VL_MODEL_NAME=qwen2.5-vl-32b-instruct

OPENAI_API_BASE=https://foundation-models.api.cloud.ru/v1
OPENAI_API_KEY=api-key-here
MODEL_NAME=Qwen/Qwen3-Next-80B-A3B-Instruct
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
LLM_TEMPERATURE=0.7

# Qdrant Vector Database
# Для локальной разработки (Linux):
QDRANT_URL=http://0.0.0.0:6333
QDRANT_API_KEY=
# Для Docker: используйте имя сервиса
# QDRANT_URL=http://qdrant:6333

# Optional: For production cloud
# QDRANT_URL=https://your-qdrant-cluster.cloud.qdrant.io
# QDRANT_API_KEY=your-qdrant-api-key

# Default PPTX Template Configuration
# Если пользователь не загружает свой шаблон, система будет использовать default template
# ВАЖНО: Файл должен быть предварительно загружен в S3 bucket по указанному ключу
# 
# Инструкция по настройке:
# 1. Загрузите PPTX файл в S3: aws s3 cp your_template.pptx s3://your-bucket/templates/default_template.pptx
# 2. Или используйте MinIO Console (http://localhost:9001) для загрузки файла
# 3. Укажите S3 ключ ниже (путь к файлу внутри bucket)
# 4. Проверьте доступность: curl http://localhost:8000/api/checkDefaultTemplate
#
# Пример для AWS S3:
DEFAULT_TEMPLATE_S3_KEY=templates/default_template.pptx
#
# Пример для локального MinIO:
# DEFAULT_TEMPLATE_S3_KEY=templates/rosatom_template.pptx
#
# Оставьте пустым если не хотите использовать default template:
# DEFAULT_TEMPLATE_S3_KEY=

# Gotenberg API for PPTX to PDF conversion
# Для локальной разработки (Linux):
GOTENBERG_URL=http://0.0.0.0:3030
# Для Docker: используйте имя сервиса
# GOTENBERG_URL=http://gotenberg:3030

# OCR Configuration
# Set to 'true' to enable OCR when text extraction fails
ENABLE_OCR=true
MIN_TEXT_LENGTH=1000

# Kandinsky Image Generation API
KANDINSKY_API_KEY=your-kandinsky-api-key-here
KANDINSKY_SECRET_KEY=your-kandinsky-secret-key-here
